MIMO_API_KEY=replace-with-your-mimo-api-key
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
# Optional exact override, useful for custom gateways:
# MIMO_MESSAGES_URL=https://token-plan-sgp.xiaomimimo.com/anthropic/v1/messages
MIMO_MODEL=mimo-v2.5

# Cohesivity Google social login.
# Locally, `curl -sS -X POST https://cohesivity.ai/api/genesis -o .cohesivity`
# also works because the dev server reads tenant_id from `.cohesivity`.
COHESIVITY_TENANT_ID=replace-with-your-cohesivity-tenant-id
COHESIVITY_ORIGIN=https://cohesivity.ai
# Required only for signed-in cloud sheet saves. Keep server-side only.
COHESIVITY_APPLICATION_KEY=replace-with-your-cohesivity-application-key
